# Optional developer override only.
# The personal app normally uses src/config/supabaseProjectConfig.js.
# Set this to true only if you deliberately want env vars to override the app-owned Supabase config.
VITE_SUPABASE_USE_ENV_OVERRIDE=false
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-public-key

# Required for phone QR on localhost and Vercel-hosted deployments.
# Use the stable public production app URL, not localhost, a preview URL, or the Vercel dashboard.
VITE_PUBLIC_APP_URL=https://your-production-app-url.vercel.app
